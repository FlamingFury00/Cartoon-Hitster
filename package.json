{
  "name": "sigle-in-fila",
  "private": true,
  "version": "1.0.0",
  "description": "Sigle in Fila - il gioco musicale delle sigle dei cartoni animati (Hitster-style timeline party game)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deck:build": "node tools/build-deck.mjs",
    "deck:validate": "node tools/validate-deck.mjs",
    "build:android": "vite build --mode android --outDir dist-android",
    "apk": "npm run build:android && cd android && ./gradlew assembleRelease",
    "deck:match": "node tools/deck/match.mjs deck/songs.csv",
    "icons": "node tools/assets/render-icons.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@playwright/test": "^1.56.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
